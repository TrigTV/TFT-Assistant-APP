# Copy this file to .env and paste your key. Never commit .env.
# Development and production keys go in the same variable; nothing else changes.
# Leave RIOT_API_KEY empty to read the key from the file below instead.
RIOT_API_KEY=
RIOT_API_KEY_FILE=riot_api_key.txt

# Platform host for summoner/league/status calls (na1, euw1, eun1, kr, jp1, oc1, br1, la1, la2, tr1, ru, me1, ph2, sg2, th2, tw2, vn2)
RIOT_PLATFORM=na1

# Regional host for account and match calls (americas, europe, asia, sea)
RIOT_REGION=americas
